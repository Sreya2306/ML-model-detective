pressure_differences=[3.2, 7.5, 17.0, -2.0, 12.4, 21.8, 4.9]
normal_count = 0
warning_count = 0
critical_count = 0
invalid_count = 0
print("\n Pipeline Batch Report")
for difference in pressure_differences:
    if difference<0:
        status="Invalid"
        invalid_count+=1
    else:
        if difference<5:
            status="Normal"
            normal_count+=1
        elif difference<15:
            status="Warning"
            warning_count+=1
        else:
            status="Critical"
            critical_count+=1
    print(f"Reading: {difference} | {status}")
print("\n Summary")
print(f"Normal readings: {normal_count}")
print(f"Warning readings: {warning_count}")
print(f"Critical readings: {critical_count}")
print(f"Invalid readings: {invalid_count}")
    
